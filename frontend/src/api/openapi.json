  "components": {
    "schemas": {
      "AdviceRequest": {
        "properties": {
          "crop": {
            "type": "string",
            "title": "Crop"
          },
          "mandi": {
            "type": "string",
            "title": "Mandi"
          },
          "quantity_maund": {
            "type": "number",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Quantity Maund"
          },
          "storage": {
            "type": "string",
            "enum": [
              "none",
              "home",
              "cold_store",
              "warehouse"
            ],
            "title": "Storage"
          },
          "storage_cost_per_maund_week": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Storage Cost Per Maund Week"
          },
          "spoilage_pct_week": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Spoilage Pct Week"
          },
          "finance_cost_pct_month": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Finance Cost Pct Month"
          },
          "as_of": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "lang": {
            "type": "string",
            "enum": [
              "ur",
              "en"
            ],
            "title": "Lang",
            "default": "ur"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "crop",
          "mandi",
          "quantity_maund",
          "storage"
        ],
        "title": "AdviceRequest"
      },
      "AdviceResponse": {
        "properties": {
          "data_source": {
            "type": "string",
            "title": "Data Source"
          },
          "is_synthetic": {
            "type": "boolean",
            "title": "Is Synthetic"
          },
          "as_of": {
            "type": "string",
            "format": "date",
            "title": "As Of"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "sell_now",
              "sell_elsewhere",
              "store",
              "split"
            ],
            "title": "Verdict"
          },
          "verdict_text": {
            "type": "string",
            "title": "Verdict Text"
          },
          "rupee_difference": {
            "type": "number",
            "title": "Rupee Difference"
          },
          "best_week": {
            "type": "integer",
            "title": "Best Week"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons"
          },
          "risk_line": {
            "type": "string",
            "title": "Risk Line"
          },
          "alternative_mandi": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AlternativeMandi"
              },
              {
                "type": "null"
              }
            ]
          },
          "alerts": {
            "items": {
              "$ref": "#/components/schemas/EventRef"
            },
            "type": "array",
            "title": "Alerts"
          },
          "alarm_tier": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "normal",
                  "stress",
                  "alert",
                  "crisis"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Alarm Tier"
          },
          "assumptions": {
            "items": {
              "$ref": "#/components/schemas/AssumptionUsed"
            },
            "type": "array",
            "title": "Assumptions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "data_source",
          "is_synthetic",
          "as_of",
          "verdict",
          "verdict_text",
          "rupee_difference",
          "best_week",
          "reasons",
          "risk_line",
          "alternative_mandi",
          "alerts",
          "alarm_tier",
          "assumptions"
        ],
        "title": "AdviceResponse"
      },
      "Alarm": {
        "properties": {
          "crop": {
            "type": "string",
            "title": "Crop"
          },
          "mandi": {
            "type": "string",
            "title": "Mandi"
          },
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "indicator": {
            "type": "number",
            "title": "Indicator"
          },
          "tier": {
            "type": "string",
            "enum": [
              "normal",
              "stress",
              "alert",
              "crisis"
            ],
            "title": "Tier"
          },
          "flags": {
            "items": {
              "type": "string",
              "enum": [
                "below_3yr_harvest_avg",
                "yoy_drop_over_50pct"
              ]
            },
            "type": "array",
            "title": "Flags"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "crop",
          "mandi",
          "date",
          "indicator",
          "tier",
          "flags"
        ],
        "title": "Alarm"
      },
      "AlertsResponse": {
        "properties": {
          "data_source": {
            "type": "string",
            "title": "Data Source"
          },
          "is_synthetic": {
            "type": "boolean",
            "title": "Is Synthetic"
          },
          "crop": {
            "type": "string",
            "title": "Crop"
          },
          "as_of": {
            "type": "string",
            "format": "date",
            "title": "As Of"
          },
          "alarms": {
            "items": {
              "$ref": "#/components/schemas/Alarm"
            },
            "type": "array",
            "title": "Alarms"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "type": "array",
            "title": "Events"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "data_source",
          "is_synthetic",
          "crop",
          "as_of",
          "alarms",
          "events"
        ],
        "title": "AlertsResponse"
      },
      "AlternativeMandi": {
        "properties": {
          "mandi": {
            "type": "string",
            "title": "Mandi"
          },
          "net_price": {
            "type": "number",
            "title": "Net Price"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "mandi",
          "net_price"
        ],
        "title": "AlternativeMandi"
      },
      "AssumptionUsed": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "source": {
            "type": "string",
            "enum": [
              "farmer",
              "default"
            ],
            "title": "Source"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "value",
          "source"
        ],
        "title": "AssumptionUsed"
      },
      "AssumptionValue": {
        "properties": {
          "value": {
            "type": "number",
            "minimum": 0.0,
            "title": "Value"
          },
          "source": {
            "type": "string",
            "title": "Source"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "value",
          "source"
        ],
        "title": "AssumptionValue"
      },
      "Assumptions": {
        "properties": {
          "finance_cost_pct_month": {
            "$ref": "#/components/schemas/AssumptionValue"
          },
          "storage_defaults": {
            "items": {
              "$ref": "#/components/schemas/StorageDefault"
            },
            "type": "array",
            "title": "Storage Defaults"
          },
          "transport": {
            "items": {
              "$ref": "#/components/schemas/TransportCost"
            },
            "type": "array",
            "title": "Transport"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "finance_cost_pct_month",
          "storage_defaults",
          "transport"
        ],
        "title": "Assumptions"
      },
      "BacktestArtifact": {
        "properties": {
          "data_source": {
            "type": "string",
            "title": "Data Source"
          },
          "is_synthetic": {
            "type": "boolean",
            "title": "Is Synthetic"
          },
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version"
          },
          "horizon_weeks": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Horizon Weeks"
          },
          "cutoffs": {
            "items": {
              "type": "string",
              "format": "date"
            },
            "type": "array",
            "title": "Cutoffs"
          },
          "metrics": {
            "items": {
              "$ref": "#/components/schemas/MetricRow"
            },
            "type": "array",
            "title": "Metrics"
          },
          "rupee_backtest": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RupeeBacktest"
              },
              {
                "type": "null"
              }
            ]
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "data_source",
          "is_synthetic",
          "schema_version",
          "horizon_weeks",
          "cutoffs",
          "metrics",
          "rupee_backtest",
          "limitations"
        ],
        "title": "BacktestArtifact"
      },
      "BandPoint": {
        "properties": {
          "weeks_ahead": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Weeks Ahead"
          },
          "q10": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Q10"
          },
          "q50": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Q50"
          },
          "q90": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Q90"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "weeks_ahead",
          "q10",
          "q50",
          "q90"
        ],
        "title": "BandPoint"
      },
      "ChatRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Question"
          },
          "crop_option": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "Wheat",
                  "Cotton",
                  "IRRI",
                  "SuperBasmati"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Crop Option"
          },
          "mandi": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "BahawalPur",
                  "Vehari",
                  "RahimYarKhan"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Mandi"
          },
          "quantity_maund": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Quantity Maund"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "used_fallback": {
            "type": "boolean",
            "title": "Used Fallback"
          },
          "fallback_reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "need_crop_and_mandi",
                  "no_data",
                  "service_not_ready",
                  "rate_limited",
                  "llm_unavailable",
                  "unverified_numbers",
                  "wrong_script"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Fallback Reason"
          },
          "crop_option": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Crop Option"
          },
          "mandi": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mandi"
          },
          "data_source": {
            "type": "string",
            "title": "Data Source"
          },
          "is_synthetic": {
            "type": "boolean",
            "title": "Is Synthetic"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "used_fallback",
          "fallback_reason",
          "crop_option",
          "mandi",
          "data_source",
          "is_synthetic"
        ],
        "title": "ChatResponse"
      },
