# Copy to .env and fill in. .env is gitignored. Share real values outside git.
#
# Do NOT name the LLM key ANTHROPIC_API_KEY: Claude Code would bill that key
# instead of your subscription (docs/PLAN.md section 9.2).

# Gemini, for the farmer chat (backend/app/chat). Without a key, chat sends the template reply.
FS_LLM_API_KEY=
# FS_LLM_MODEL=gemini-3.5-flash-lite
# FS_LLM_THINKING_LEVEL=
# FS_LLM_RATE_PER_MIN=10
# FS_CHAT_RATE_PER_MIN=20

# WhatsApp Cloud API (backend/app/channels/whatsapp.py). From the Meta app: WhatsApp > API Setup.
# FS_WA_VERIFY_TOKEN is any string you also type into the Meta webhook settings.
FS_WA_VERIFY_TOKEN=
FS_WA_APP_SECRET=
FS_WA_ACCESS_TOKEN=
FS_WA_PHONE_NUMBER_ID=
# FS_WA_API_VERSION=v23.0
# Alerts outside the 24-hour reply window need a Meta-approved template with one body parameter.
# FS_WA_ALERT_TEMPLATE=
# FS_WA_ALERT_TEMPLATE_LANG=ur

# SMS by TextBee, an Android phone's SIM (backend/app/channels/textbee.py, setup in docs/TEXTBEE_SMS.md).
# Leave SMS_PROVIDER empty to keep SMS off. The webhook secret must be 20+ characters and match the TextBee webhook.
SMS_PROVIDER=
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
TEXTBEE_WEBHOOK_SECRET=
# Or the "SMS Gateway API" Android app (backend/app/channels/simpapp.py, setup in docs/SIMPAPP_SMS.md).
# SMS_PROVIDER=simpapp. The webhook secret (20+ characters) goes at the end of the webhook URL typed into the app.
SIMPAPP_SMS_API_URL=https://europe-west1-sms-gateway-api-simpapp.cloudfunctions.net/api_sms_send
SIMPAPP_SMS_API_KEY=
SIMPAPP_WEBHOOK_SECRET=

# Price alerts (backend/app/alerts.py). Hours between automatic checks; 0 or empty = off.
# FS_ALERTS_EVERY_HOURS=0
# Lets the team run a check on demand: POST /api/alerts/run with header X-Admin-Token. Empty = route off.
FS_ADMIN_TOKEN=

# Backend: signs the farmers' login tokens. Any long random string; keep it the same across restarts or
# everyone is logged out. Make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FS_JWT_SECRET=

# Backend: the SQLite file for farmers, logs and alerts. Defaults to <repo>/var/farmsight.sqlite.
# On a host without a persistent disk the database resets on every restart (the demo farmer is re-seeded).
# FS_DB_PATH=

# Backend: comma-separated origins allowed to call the API from a browser.
# Local dev uses the Vite proxy, so this only matters once deployed.
FS_CORS_ORIGINS=http://localhost:5173
